---
interface Props {
  class?: string;
  spacing?: 'tight' | 'normal' | 'loose';
}

const {
  class: className = '',
  spacing = 'normal',
} = Astro.props;

const spacings = {
  tight: 'py-8',
  normal: 'py-16',
  loose: 'py-24',
};

const classes = `w-full ${spacings[spacing]} ${className}`;
---

<section class={classes}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
    <slot />
  </div>
</section>
