---
/**
 * Sentry Error Tracking Component
 * 
 * Loads Sentry for error monitoring and performance tracking.
 * Gracefully skips if PUBLIC_SENTRY_DSN is not configured.
 */

const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN;
const isEnabled = !!sentryDsn;
const isProd = import.meta.env.PROD;
---

{isEnabled && (
  <script
    is:inline
    define:vars={{ sentryDsn, isProd }}
  >
    // Lazy load Sentry to not block page render
    (function() {
      const script = document.createElement('script');
      script.src = 'https://browser.sentry-cdn.com/8.39.0/bundle.min.js';
      script.crossOrigin = 'anonymous';
      script.onload = function() {
        if (window.Sentry) {
          window.Sentry.init({
            dsn: sentryDsn,
            environment: isProd ? 'production' : 'development',
            // Only send errors in production
            enabled: isProd,
            // Performance monitoring
            tracesSampleRate: isProd ? 0.1 : 1.0,
            // Replay for error context
            replaysSessionSampleRate: 0,
            replaysOnErrorSampleRate: isProd ? 1.0 : 0,
            // Ignore common non-actionable errors
            ignoreErrors: [
              'ResizeObserver loop limit exceeded',
              'Non-Error promise rejection captured',
              /^Script error\.?$/,
              /^Network Error$/,
            ],
            beforeSend: function(event) {
              // Don't send events in development
              if (!isProd) return null;
              return event;
            },
          });
        }
      };
      document.head.appendChild(script);
    })();
  </script>
)}
