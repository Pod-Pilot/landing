---
// Hero Component - Full-height hero with floating geometric shapes and magnetic CTA
import { config } from '../config';
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero-shapes" aria-hidden="true">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>
  
  <div class="hero-content">
    <p class="hero-label">App Deployment Made Simple</p>
    <h1 class="hero-title" id="hero-title">
      <span class="line"><span>Make infrastructure</span></span>
      <span class="line"><span class="highlight">invisible.</span></span>
    </h1>
    <p class="hero-subtitle">
      Deploy any containerized app in minutes. <strong>Push code, auto-deploy, scale effortlessly</strong>—zero infrastructure complexity, just results you can count on.
    </p>
    <div class="cta-wrapper">
      <a href={config.consoleUrl} class="cta-btn" aria-label="Start deploying your app now">
        Deploy Your First App
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
    <p class="hero-trust-signal">14-day free trial • No credit card required • Live in under 5 minutes</p>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<script is:inline>
  // Magnetic button effect
  const ctaBtn = document.querySelector('.cta-btn');

  if (ctaBtn) {
    ctaBtn.addEventListener('mousemove', (e) => {
      const rect = ctaBtn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      ctaBtn.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px) scale(1.05)`;
    });

    ctaBtn.addEventListener('mouseleave', () => {
      ctaBtn.style.transform = '';
    });
  }
</script>
