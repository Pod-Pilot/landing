---

<section class="py-16 bg-muted/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
    <div class="text-center mb-16">
      <h2 class="text-h1 sm:text-[32px] mb-4">Deploy in four steps</h2>
      <p class="text-muted-foreground max-w-[600px] mx-auto">
        From code to production in minutes
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-8 relative">
      <!-- Connection lines (hidden on mobile) -->
      <div class="hidden md:block absolute top-12 left-0 right-0 h-0.5 bg-border" style="width: calc(100% - 8rem); margin: 0 4rem;"></div>

      <!-- Step 1 -->
      <div class="relative flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-bold mb-4 z-10 relative">
          1
        </div>
        <h3 class="text-h2 font-semibold mb-2">Connect Repository</h3>
        <p class="text-sm text-muted-foreground">
          Link your GitHub, GitLab, or Bitbucket repository
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-bold mb-4 z-10 relative">
          2
        </div>
        <h3 class="text-h2 font-semibold mb-2">Configure</h3>
        <p class="text-sm text-muted-foreground">
          Set environment variables and resource limits
        </p>
      </div>

      <!-- Step 3 -->
      <div class="relative flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-bold mb-4 z-10 relative">
          3
        </div>
        <h3 class="text-h2 font-semibold mb-2">Deploy</h3>
        <p class="text-sm text-muted-foreground">
          Push to main and watch your app go live
        </p>
      </div>

      <!-- Step 4 -->
      <div class="relative flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-bold mb-4 z-10 relative">
          4
        </div>
        <h3 class="text-h2 font-semibold mb-2">Scale</h3>
        <p class="text-sm text-muted-foreground">
          Automatic scaling handles traffic for you
        </p>
      </div>
    </div>

    <!-- Workflow Diagram Placeholder -->
    <div class="mt-16 rounded-lg border border-border bg-card p-8 text-center">
      <div class="text-muted-foreground">
        <p class="text-sm mb-2">TODO: Workflow diagram visual</p>
        <p class="text-xs">PLACEHOLDER-workflow-diagram.svg</p>
      </div>
    </div>
  </div>
</section>
