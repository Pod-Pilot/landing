---
import Card from '@/components/common/Card.astro';
---

<section class="py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
    <div class="text-center mb-12">
      <h2 class="text-h1 sm:text-[32px] mb-4">Everything you need to deploy</h2>
      <p class="text-muted-foreground max-w-[600px] mx-auto">
        Built-in features that just work
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Feature 1: Git Integration - HIGHLIGHTED (spans 2 columns on lg) -->
      <Card hover={true} class="lg:col-span-2">
        <div class="grid sm:grid-cols-2 gap-6">
          <!-- Icon and Title Column -->
          <div class="space-y-3">
            <div class="p-3 w-fit rounded-xl bg-signal-green/10 border border-signal-green/20">
              <svg class="w-8 h-8 text-signal-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-h2 font-semibold">Git Integration</h3>
            <p class="text-base text-muted-foreground">
              Connect GitHub, GitLab, or Bitbucket. Push to main and watch your app deploy automatically. No config files, no CI/CD pipelines to maintain.
            </p>
          </div>
          <!-- Visual Element -->
          <div class="flex items-center justify-center bg-muted/50 rounded-lg p-4">
            <div class="space-y-2 w-full max-w-[250px]">
              <div class="flex items-center gap-2 text-sm">
                <div class="w-2 h-2 rounded-full bg-signal-green"></div>
                <span class="font-mono text-xs text-muted-foreground">git push → deploy</span>
              </div>
              <div class="h-1 bg-signal-green/20 rounded-full overflow-hidden">
                <div class="h-full w-3/4 bg-signal-green rounded-full"></div>
              </div>
              <div class="text-xs text-muted-foreground font-mono">Auto-deploy enabled</div>
            </div>
          </div>
        </div>
      </Card>

      <!-- Feature 2: Auto-scaling -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Auto-scaling</h3>
          <p class="text-base text-muted-foreground">
            Scales up during traffic spikes, scales down to save costs automatically.
          </p>
        </div>
      </Card>

      <!-- Feature 3: Real-time Logs -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Real-time Logs</h3>
          <p class="text-base text-muted-foreground">
            Stream logs from all containers. Search, filter, and debug in real-time.
          </p>
        </div>
      </Card>

      <!-- Feature 4: Zero-downtime Deploys -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Zero-downtime Deploys</h3>
          <p class="text-base text-muted-foreground">
            Rolling updates ensure your app stays online during deployments.
          </p>
        </div>
      </Card>

      <!-- Feature 5: Environment Variables -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Environment Variables</h3>
          <p class="text-base text-muted-foreground">
            Secure secret management. Encrypted at rest, injected at runtime.
          </p>
        </div>
      </Card>

      <!-- Feature 6: Custom Domains -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Custom Domains</h3>
          <p class="text-base text-muted-foreground">
            Point your domain to your app. Automatic SSL certificates included.
          </p>
        </div>
      </Card>

      <!-- Feature 7: Monitoring -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Monitoring</h3>
          <p class="text-base text-muted-foreground">
            Built-in metrics, alerts, and uptime monitoring. Know when issues happen.
          </p>
        </div>
      </Card>

      <!-- Feature 8: CI/CD -->
      <Card hover={true}>
        <div class="space-y-3">
          <div class="p-3 w-fit rounded-xl bg-muted border border-border">
            <svg class="w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">CI/CD Pipeline</h3>
          <p class="text-base text-muted-foreground">
            Run tests, build containers, and deploy automatically. No config needed.
          </p>
        </div>
      </Card>
    </div>
  </div>
</section>
