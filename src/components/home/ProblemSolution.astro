---
import Card from '@/components/common/Card.astro';
---

<section class="py-16 bg-muted/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
    <div class="text-center mb-12">
      <h2 class="text-h1 sm:text-[32px] mb-4">Infrastructure shouldn't be your problem</h2>
      <p class="text-muted-foreground max-w-[600px] mx-auto">
        Deploy faster by eliminating infrastructure complexity
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Problem 1 → Solution -->
      <Card hover={true}>
        <div class="flex flex-col items-center text-center space-y-4">
          <div class="p-3 rounded-lg bg-muted">
            <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Complex Infrastructure</h3>
          <p class="text-sm text-muted-foreground">
            Kubernetes configuration takes weeks. Kubeletto deploys in minutes with zero config.
          </p>
        </div>
      </Card>

      <!-- Problem 2 → Solution -->
      <Card hover={true}>
        <div class="flex flex-col items-center text-center space-y-4">
          <div class="p-3 rounded-lg bg-muted">
            <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Slow Deployments</h3>
          <p class="text-sm text-muted-foreground">
            Manual pipelines waste time. Automated deployments from git push to production in 60 seconds.
          </p>
        </div>
      </Card>

      <!-- Problem 3 → Solution -->
      <Card hover={true}>
        <div class="flex flex-col items-center text-center space-y-4">
          <div class="p-3 rounded-lg bg-muted">
            <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-h2 font-semibold">Security Concerns</h3>
          <p class="text-sm text-muted-foreground">
            DIY security is risky. Enterprise-grade security, compliance, and monitoring included.
          </p>
        </div>
      </Card>
    </div>

    <!-- TODO: Add comparison diagram PLACEHOLDER-problem-solution-diagram.svg -->
  </div>
</section>
