---
import Button from '@/components/common/Button.astro';

const consoleUrl = import.meta.env.CONSOLE_URL || 'https://console.kubeletto.com';
---

<section class="py-24 bg-primary text-primary-foreground relative overflow-hidden">
  <!-- Background Orb -->
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-white opacity-10 blur-[120px] rounded-full -z-0"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px] text-center relative z-10">
    <h2 class="text-display sm:text-[48px] mb-6">
      Ready to ship faster?
    </h2>
    <p class="text-lg sm:text-xl opacity-90 max-w-[600px] mx-auto mb-8">
      Join developers deploying with confidence. Start free, no credit card required.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={`${consoleUrl}/sign-in`}
        class="inline-flex items-center justify-center h-12 px-8 text-base font-medium rounded-md bg-background text-foreground hover:opacity-90 transition-all duration-200 active:scale-[0.98]"
        data-ph-capture-attribute-cta="cta_section_start_free_trial"
      >
        Start Free Trial
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center h-12 px-8 text-base font-medium rounded-md bg-transparent border-2 border-current text-primary-foreground hover:bg-white/10 transition-all duration-200 active:scale-[0.98]"
        data-ph-capture-attribute-cta="cta_section_talk_to_sales"
      >
        Talk to Sales
      </a>
    </div>
  </div>
</section>
