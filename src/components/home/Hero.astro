---
import Button from '@/components/common/Button.astro';

const consoleUrl = import.meta.env.CONSOLE_URL || 'https://console.kubeletto.com';
---

<section class="relative overflow-hidden py-20 sm:py-32">
  <!-- Background Orb (The Glow) - Enhanced with Signal Green -->
  <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] bg-signal-green opacity-30 blur-[120px] rounded-full animate-orb-glow -z-10"></div>
  <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] bg-kubeletto-blue opacity-20 blur-[120px] rounded-full animate-orb-glow -z-10" style="animation-delay: 2s;"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Content -->
      <div class="space-y-8">
        <h1 class="text-display sm:text-[48px] lg:text-[56px] leading-tight">
          Deploy anywhere. Focus on code.
        </h1>
        <p class="text-base sm:text-lg text-muted-foreground max-w-[600px]">
          Kubeletto handles Kubernetes complexity so you don't have to. From git push to production in 60 seconds.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href={`${consoleUrl}/sign-in`} variant="primary" size="lg" data-ph-capture-attribute-cta="hero_start_free_trial">
            Start Free Trial
          </Button>
          <Button href="/docs" variant="secondary" size="lg" data-ph-capture-attribute-cta="hero_view_docs">
            View Docs
          </Button>
        </div>

        <!-- Trust Indicators -->
        <div class="flex flex-wrap gap-6 pt-8">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-muted-foreground">99.9% uptime</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-muted-foreground">SOC 2 compliant</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-muted-foreground">10,000+ deployments</span>
          </div>
        </div>
      </div>

      <!-- Right: Hero Terminal/Deployment Logs -->
      <div class="relative">
        <!-- Orb Glow Behind Terminal -->
        <div class="absolute inset-0 bg-signal-green opacity-10 blur-[100px] rounded-full"></div>

        <div class="relative rounded-lg border border-border overflow-hidden shadow-[0_12px_32px_-4px_rgba(0,0,0,0.15)] bg-slate-900">
          <!-- Terminal Header -->
          <div class="bg-slate-800 px-4 py-2 flex items-center gap-2 border-b border-slate-700">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <span class="text-xs text-slate-400 font-mono ml-2">deployment-logs</span>
          </div>

          <!-- Terminal Content -->
          <div class="p-6 font-mono text-[13px] leading-relaxed space-y-1 bg-slate-950/50">
            <div class="text-slate-500">$ git push origin main</div>
            <div class="text-slate-400">Deploying to production...</div>
            <div class="text-slate-400 mt-2">→ Building container image</div>
            <div class="text-green-400">✓ Build completed in 12s</div>
            <div class="text-slate-400">→ Pushing to registry</div>
            <div class="text-green-400">✓ Image pushed successfully</div>
            <div class="text-slate-400">→ Deploying to cluster</div>
            <div class="text-green-400">✓ Rolling update started</div>
            <div class="text-green-400">✓ Health checks passing</div>
            <div class="text-green-400">✓ Deployment complete</div>
            <div class="text-slate-400 mt-3">
              <span class="text-green-400">→</span>
              <span class="text-slate-300"> Live at: </span>
              <span class="text-blue-400 underline">https://my-app.kubeletto.app</span>
            </div>
            <div class="text-slate-500 mt-2">Deployed in 34 seconds</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
