---
// Pricing Component - Three-tier pricing cards with hover effects
import { config } from '../config';
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="section-header reveal">
    <p class="section-label">Pricing</p>
    <h2 class="section-title" id="pricing-title">Simple, transparent pricing in Rupiah.</h2>
  </div>

  <div class="pricing-cards">
    <div class="pricing-card reveal reveal-delay-1">
      <p class="pricing-tier">Starter</p>
      <p class="pricing-price">Rp 30.000 <span>/bulan</span></p>
      <p class="pricing-desc">For solo builders and early pilots.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Up to 1 project</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 512 MB RAM</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 0.5 vCPU</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1 GB storage</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 3 custom domains</li>
      </ul>
      <a href={config.consoleUrl} class="pricing-btn secondary">Get Started</a>
    </div>

    <div class="pricing-card featured reveal reveal-delay-2">
      <p class="pricing-tier">Pro</p>
      <p class="pricing-price">Rp 90.000 <span>/bulan</span></p>
      <p class="pricing-desc">For teams shipping multiple services.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Up to 3 projects</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1.5 GB RAM</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1.5 vCPU</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 5 GB storage</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 9 custom domains</li>
      </ul>
      <a href={config.consoleUrl} class="pricing-btn primary">Subscribe</a>
    </div>

    <div class="pricing-card reveal reveal-delay-3">
      <p class="pricing-tier">Enterprise</p>
      <p class="pricing-price">Custom</p>
      <p class="pricing-desc">For organizations with advanced needs.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Everything in Pro</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> SSO & SAML</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> SLA guarantee</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Dedicated support</li>
      </ul>
      <a href={config.consoleUrl} class="pricing-btn secondary">Contact Sales</a>
    </div>
  </div>

  <p class="pricing-note reveal reveal-delay-4">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
    Secure encrypted payments. Resource limits and custom domains are total allocations per plan.
  </p>
</section>

<style>
  .pricing-note {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pricing-note svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
