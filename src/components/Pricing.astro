---
// Pricing Component - Three-tier pricing cards with hover effects
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="section-header reveal">
    <p class="section-label">Pricing</p>
    <h2 class="section-title" id="pricing-title">Simple, transparent pricing.</h2>
  </div>

  <div class="pricing-cards">
    <div class="pricing-card reveal reveal-delay-1">
      <p class="pricing-tier">Starter</p>
      <p class="pricing-price">$0 <span>/mo</span></p>
      <p class="pricing-desc">Perfect for side projects and learning.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1 project</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Shared resources</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Community support</li>
      </ul>
      <a href="#signup" class="pricing-btn secondary">Get Started</a>
    </div>

    <div class="pricing-card featured reveal reveal-delay-2">
      <p class="pricing-tier">Pro</p>
      <p class="pricing-price">$29 <span>/mo</span></p>
      <p class="pricing-desc">For growing teams and production apps.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Unlimited projects</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Dedicated resources</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Priority support</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Custom domains</li>
      </ul>
      <a href="#signup" class="pricing-btn primary">Subscribe</a>
    </div>

    <div class="pricing-card reveal reveal-delay-3">
      <p class="pricing-tier">Enterprise</p>
      <p class="pricing-price">Custom</p>
      <p class="pricing-desc">For organizations with advanced needs.</p>
      <ul class="pricing-features">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Everything in Pro</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> SSO & SAML</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> SLA guarantee</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Dedicated support</li>
      </ul>
      <a href="#signup" class="pricing-btn secondary">Contact Sales</a>
    </div>
  </div>
</section>
