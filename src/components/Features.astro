---
// Features Component - Bento grid layout with terminal demo animation
---

<section class="features" id="features" aria-labelledby="features-title">
  <div class="section-header reveal">
    <p class="section-label">Why Choose Kubeletto</p>
    <h2 class="section-title" id="features-title">Everything You Need. Nothing You Don't.</h2>
    <p class="section-subtitle">Streamlined workflows for developers who value simplicity. We handle the infrastructure so you can focus on building.</p>
  </div>

  <div class="bento-grid">
    <!-- Large card with terminal demo -->
    <div class="bento-card large reveal reveal-delay-1">
      <div class="bento-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
      </div>
      <h3 class="bento-title">Git Push to Deploy</h3>
      <p class="bento-desc">Connect your repository and deploy automatically. <strong>Zero configuration needed</strong>—just push code and watch it go live in seconds.</p>
      <div class="terminal-demo" aria-hidden="true">
        <div class="terminal-header">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
        </div>
        <div class="terminal-line"><span class="prompt">$</span> git push origin main</div>
        <div class="terminal-line"><span class="success">✓</span> Building container image...</div>
        <div class="terminal-line"><span class="success">✓</span> Deployed to production</div>
        <div class="terminal-line"><span class="success">✓</span> https://your-app.kubeletto.app</div>
      </div>
    </div>

    <!-- Medium card -->
    <div class="bento-card medium reveal reveal-delay-2">
      <div class="bento-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <h3 class="bento-title">Smart Defaults, Full Control</h3>
      <p class="bento-desc">Optimized settings that work for 90% of use cases, with <strong>advanced options</strong> available when you need them. The best of both worlds.</p>
    </div>

    <!-- Medium card -->
    <div class="bento-card medium reveal reveal-delay-3">
      <div class="bento-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </div>
      <h3 class="bento-title">Built-In Reliability</h3>
      <p class="bento-desc">Automatic SSL, custom domains, and real-time monitoring. <strong>Clear error messages</strong> with actionable fixes when something goes wrong.</p>
    </div>

    <!-- Large card -->
    <div class="bento-card large reveal reveal-delay-4">
      <div class="bento-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"></path></svg>
      </div>
      <h3 class="bento-title">Affordable at Any Scale</h3>
      <p class="bento-desc"><strong>14-day free trial</strong>, then starting at Rp 30.000/bulan. Run backend APIs, web apps, databases, or microservices. <strong>Scale from side project to production</strong> without breaking the bank.</p>
    </div>
  </div>
</section>

<script is:inline>
  // Terminal animation
  const terminalObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const lines = entry.target.querySelectorAll('.terminal-line');
        lines.forEach((line, i) => {
          setTimeout(() => {
            line.classList.add('visible');
          }, i * 400);
        });
        terminalObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const terminalDemo = document.querySelector('.terminal-demo');
  if (terminalDemo) {
    terminalObserver.observe(terminalDemo);
  }
</script>
