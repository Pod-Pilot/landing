---
import '@/styles/global.css';
import Analytics from '@/components/common/Analytics.astro';
import ErrorTracking from '@/components/common/ErrorTracking.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Kubeletto - Deploy anywhere. Focus on code.',
  description = 'Kubeletto handles Kubernetes complexity so you don\'t have to. From git push to production in 60 seconds.',
  ogImage = '/assets/images/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = import.meta.env.PUBLIC_SITE_TITLE || 'Kubeletto';
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    <!-- OpenGraph tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Kubeletto',
      url: Astro.site,
      logo: new URL('/logo-with-name.svg', Astro.site),
      description: description,
      sameAs: [
        'https://github.com/kubeletto',
        'https://twitter.com/kubeletto',
      ],
    })} />

    <!-- Analytics & Error Tracking -->
    <ErrorTracking />
    <Analytics />

    <!-- Theme Script (Prevent Flash) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
