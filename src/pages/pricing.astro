---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Section from '@/components/common/Section.astro';
import Card from '@/components/common/Card.astro';
import Button from '@/components/common/Button.astro';

const consoleUrl = import.meta.env.CONSOLE_URL || 'https://console.kubeletto.com';
---

<BaseLayout title="Pricing - Kubeletto" description="Simple, transparent pricing for teams of all sizes">
  <Header />
  <main>
    <!-- Hero -->
    <Section spacing="loose">
      <div class="text-center max-w-[800px] mx-auto">
        <h1 class="text-display sm:text-[48px] mb-6">Simple, transparent pricing</h1>
        <p class="text-lg text-muted-foreground mb-8">
          Start free. Scale when you're ready. No hidden fees.
        </p>

        <!-- Billing Toggle -->
        <div class="inline-flex items-center gap-4 p-1 rounded-lg bg-muted mb-12">
          <button class="billing-toggle px-4 py-2 rounded-md text-sm font-medium transition-colors bg-background text-foreground" data-billing="monthly">
            Monthly
          </button>
          <button class="billing-toggle px-4 py-2 rounded-md text-sm font-medium transition-colors text-muted-foreground hover:text-foreground" data-billing="yearly">
            Yearly <span class="text-xs text-green-500 ml-1">(Save 20%)</span>
          </button>
        </div>
      </div>

      <!-- Pricing Cards -->
      <div class="grid md:grid-cols-3 gap-8 max-w-[1000px] mx-auto">
        <!-- Free -->
        <Card>
          <div class="space-y-6">
            <div>
              <h3 class="text-h2 font-semibold mb-2">Free</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold">$0</span>
                <span class="text-muted-foreground">/month</span>
              </div>
              <p class="text-sm text-muted-foreground">Perfect for personal projects</p>
            </div>

            <Button href={`${consoleUrl}/sign-up`} variant="secondary" class="w-full">
              Start Free
            </Button>

            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>1 project</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>100 builds/month</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>512MB RAM</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Community support</span>
              </li>
            </ul>
          </div>
        </Card>

        <!-- Pro (Highlighted) -->
        <Card class="ring-2 ring-primary relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-semibold rounded-pill bg-primary text-primary-foreground">
            Most Popular
          </div>
          <div class="space-y-6">
            <div>
              <h3 class="text-h2 font-semibold mb-2">Pro</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold price-monthly">$29</span>
                <span class="text-4xl font-bold price-yearly hidden">$23</span>
                <span class="text-muted-foreground">/month</span>
              </div>
              <p class="text-sm text-muted-foreground">For growing teams and startups</p>
            </div>

            <Button href={`${consoleUrl}/sign-up?plan=pro`} variant="primary" class="w-full">
              Start Free Trial
            </Button>

            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Unlimited projects</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Unlimited builds</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>4GB RAM per project</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Priority support</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Custom domains</span>
              </li>
            </ul>
          </div>
        </Card>

        <!-- Enterprise -->
        <Card>
          <div class="space-y-6">
            <div>
              <h3 class="text-h2 font-semibold mb-2">Enterprise</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold">Custom</span>
              </div>
              <p class="text-sm text-muted-foreground">For large teams with custom needs</p>
            </div>

            <Button href="/contact" variant="secondary" class="w-full">
              Contact Sales
            </Button>

            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Everything in Pro</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>SLA guarantees</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Dedicated support</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>SSO integration</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Custom contracts</span>
              </li>
            </ul>
          </div>
        </Card>
      </div>
    </Section>

    <!-- FAQ -->
    <Section spacing="loose" class="bg-muted/30">
      <div class="max-w-[800px] mx-auto">
        <h2 class="text-h1 sm:text-[32px] text-center mb-12">Frequently asked questions</h2>

        <div class="space-y-4">
          <details class="group rounded-lg border border-border bg-card p-6">
            <summary class="cursor-pointer text-h2 font-semibold flex justify-between items-center">
              Can I change plans later?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-muted-foreground">
              Yes, you can upgrade or downgrade your plan at any time. Changes take effect immediately.
            </p>
          </details>

          <details class="group rounded-lg border border-border bg-card p-6">
            <summary class="cursor-pointer text-h2 font-semibold flex justify-between items-center">
              What payment methods do you accept?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-muted-foreground">
              We accept all major credit cards (Visa, Mastercard, American Express) and PayPal.
            </p>
          </details>

          <details class="group rounded-lg border border-border bg-card p-6">
            <summary class="cursor-pointer text-h2 font-semibold flex justify-between items-center">
              Is there a free trial for paid plans?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-muted-foreground">
              Yes, all paid plans come with a 14-day free trial. No credit card required to start.
            </p>
          </details>

          <details class="group rounded-lg border border-border bg-card p-6">
            <summary class="cursor-pointer text-h2 font-semibold flex justify-between items-center">
              What happens if I exceed my build limits?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-muted-foreground">
              On the Free plan, builds will be queued until the next month. On paid plans, there are no build limits.
            </p>
          </details>

          <details class="group rounded-lg border border-border bg-card p-6">
            <summary class="cursor-pointer text-h2 font-semibold flex justify-between items-center">
              Do you offer refunds?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-muted-foreground">
              Yes, we offer a 30-day money-back guarantee on all paid plans. No questions asked.
            </p>
          </details>
        </div>

        <div class="text-center mt-12">
          <p class="text-muted-foreground mb-4">Still have questions?</p>
          <Button href="/contact" variant="secondary">
            Contact Sales
          </Button>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Billing toggle
  const toggleButtons = document.querySelectorAll('.billing-toggle');
  const monthlyPrices = document.querySelectorAll('.price-monthly');
  const yearlyPrices = document.querySelectorAll('.price-yearly');

  toggleButtons.forEach(button => {
    button.addEventListener('click', () => {
      const billing = button.getAttribute('data-billing');

      // Update button states
      toggleButtons.forEach(btn => {
        if (btn.getAttribute('data-billing') === billing) {
          btn.classList.add('bg-background', 'text-foreground');
          btn.classList.remove('text-muted-foreground', 'hover:text-foreground');
        } else {
          btn.classList.remove('bg-background', 'text-foreground');
          btn.classList.add('text-muted-foreground', 'hover:text-foreground');
        }
      });

      // Toggle prices
      if (billing === 'yearly') {
        monthlyPrices.forEach(el => el.classList.add('hidden'));
        yearlyPrices.forEach(el => el.classList.remove('hidden'));
      } else {
        monthlyPrices.forEach(el => el.classList.remove('hidden'));
        yearlyPrices.forEach(el => el.classList.add('hidden'));
      }
    });
  });
</script>
