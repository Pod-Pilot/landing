---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Section from '@/components/common/Section.astro';
import Card from '@/components/common/Card.astro';
---

<BaseLayout title="About - Kubeletto" description="Learn about Kubeletto's mission to make infrastructure invisible">
  <Header />
  <main>
    <Section spacing="loose">
      <div class="max-w-[800px] mx-auto text-center">
        <h1 class="text-display sm:text-[48px] mb-6">Infrastructure should be invisible</h1>
        <p class="text-lg text-muted-foreground mb-8">
          At Kubeletto, we believe developers should focus on building products, not managing infrastructure. Our mission is to make Kubernetes deployment as simple as git push.
        </p>
      </div>
    </Section>

    <!-- Our Story -->
    <Section>
      <div class="max-w-[800px] mx-auto">
        <h2 class="text-h1 sm:text-[32px] mb-6">Our Story</h2>
        <div class="prose max-w-none space-y-4 text-muted-foreground">
          <p>
            Kubeletto was born from frustration. We spent too many hours configuring Kubernetes, debugging YAML files, and wrestling with deployment pipelines. Time that should have been spent building features.
          </p>
          <p>
            We built Kubeletto to solve this problem. A platform where deployments just work. Where infrastructure fades into the background. Where developers ship code, not configuration.
          </p>
          <p>
            Today, thousands of developers trust Kubeletto to deploy their applications. From solo developers shipping side projects to teams scaling to millions of users.
          </p>
        </div>
      </div>
    </Section>

    <!-- Values -->
    <Section spacing="loose" class="bg-muted/30">
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-h1 sm:text-[32px] text-center mb-12">Our Values</h2>

        <div class="grid md:grid-cols-3 gap-8">
          <Card>
            <div class="space-y-3 text-center">
              <div class="p-3 w-fit rounded-lg bg-primary/10 mx-auto">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Simplicity</h3>
              <p class="text-sm text-muted-foreground">
                Complex problems deserve simple solutions. We hide complexity, not features.
              </p>
            </div>
          </Card>

          <Card>
            <div class="space-y-3 text-center">
              <div class="p-3 w-fit rounded-lg bg-primary/10 mx-auto">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Reliability</h3>
              <p class="text-sm text-muted-foreground">
                Your application's uptime is our responsibility. We take that seriously.
              </p>
            </div>
          </Card>

          <Card>
            <div class="space-y-3 text-center">
              <div class="p-3 w-fit rounded-lg bg-primary/10 mx-auto">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Developer-first</h3>
              <p class="text-sm text-muted-foreground">
                Built by developers, for developers. We understand your workflow.
              </p>
            </div>
          </Card>
        </div>
      </div>
    </Section>

    <!-- Team Placeholder -->
    <Section>
      <div class="max-w-[1000px] mx-auto">
        <h2 class="text-h1 sm:text-[32px] text-center mb-12">Meet the Team</h2>

        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8">
          <!-- Team Member Placeholder -->
          {[1, 2, 3, 4].map(() => (
            <div class="text-center">
              <div class="w-32 h-32 rounded-full bg-muted mx-auto mb-4 flex items-center justify-center">
                <span class="text-xs font-mono text-muted-foreground">Team Member</span>
              </div>
              <h3 class="text-h2 font-semibold mb-1">Name</h3>
              <p class="text-sm text-muted-foreground">Role</p>
            </div>
          ))}
        </div>

        <p class="text-sm text-muted-foreground text-center mt-8">
          TODO: Add actual team member photos, names, and roles
        </p>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>
