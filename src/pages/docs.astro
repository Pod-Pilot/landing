---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Section from '@/components/common/Section.astro';
import Card from '@/components/common/Card.astro';
---

<BaseLayout title="Documentation - Kubeletto" description="Get started with Kubeletto. Guides, API reference, and examples.">
  <Header />
  <main>
    <Section spacing="loose">
      <div class="max-w-[1200px] mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-display sm:text-[48px] mb-6">Documentation</h1>
          <p class="text-lg text-muted-foreground max-w-[600px] mx-auto">
            Everything you need to deploy and scale your applications
          </p>

          <!-- Search Bar Placeholder -->
          <div class="max-w-[600px] mx-auto mt-8">
            <div class="relative">
              <input
                type="search"
                placeholder="Search documentation..."
                class="w-full h-12 px-4 pl-12 rounded-md border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
              />
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <p class="text-xs text-muted-foreground mt-2">TODO: Implement search functionality</p>
          </div>
        </div>

        <!-- Quick Start Cards -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Quick Start</h3>
              <p class="text-sm text-muted-foreground">
                Deploy your first app in under 5 minutes
              </p>
            </a>
          </Card>

          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Deployment Guides</h3>
              <p class="text-sm text-muted-foreground">
                Framework-specific deployment tutorials
              </p>
            </a>
          </Card>

          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">API Reference</h3>
              <p class="text-sm text-muted-foreground">
                Complete API documentation and examples
              </p>
            </a>
          </Card>

          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Environment Variables</h3>
              <p class="text-sm text-muted-foreground">
                Manage secrets and configuration
              </p>
            </a>
          </Card>

          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Custom Domains</h3>
              <p class="text-sm text-muted-foreground">
                Set up custom domains and SSL
              </p>
            </a>
          </Card>

          <Card hover={true}>
            <a href="#" class="block space-y-3">
              <div class="p-2 w-fit rounded-lg bg-primary/10">
                <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <h3 class="text-h2 font-semibold">Monitoring & Logs</h3>
              <p class="text-sm text-muted-foreground">
                View metrics and debug applications
              </p>
            </a>
          </Card>
        </div>

        <!-- Documentation Structure -->
        <div class="prose max-w-none">
          <h2 class="text-h1 mb-6">Documentation Topics</h2>

          <div class="grid md:grid-cols-2 gap-8">
            <!-- Getting Started -->
            <div>
              <h3 class="text-h2 font-semibold mb-4">Getting Started</h3>
              <ul class="space-y-2">
                <li><a href="#" class="text-primary hover:underline">Quick Start</a></li>
                <li><a href="#" class="text-primary hover:underline">Installation</a></li>
                <li><a href="#" class="text-primary hover:underline">First Deployment</a></li>
                <li><a href="#" class="text-primary hover:underline">CLI Tools</a></li>
              </ul>
            </div>

            <!-- Deployment Guides -->
            <div>
              <h3 class="text-h2 font-semibold mb-4">Deployment Guides</h3>
              <ul class="space-y-2">
                <li><a href="#" class="text-primary hover:underline">Deploy Next.js App</a></li>
                <li><a href="#" class="text-primary hover:underline">Deploy Django App</a></li>
                <li><a href="#" class="text-primary hover:underline">Deploy Laravel App</a></li>
                <li><a href="#" class="text-primary hover:underline">Deploy Docker Container</a></li>
              </ul>
            </div>

            <!-- Configuration -->
            <div>
              <h3 class="text-h2 font-semibold mb-4">Configuration</h3>
              <ul class="space-y-2">
                <li><a href="#" class="text-primary hover:underline">Environment Variables</a></li>
                <li><a href="#" class="text-primary hover:underline">Custom Domains</a></li>
                <li><a href="#" class="text-primary hover:underline">Build Settings</a></li>
                <li><a href="#" class="text-primary hover:underline">Scaling Configuration</a></li>
              </ul>
            </div>

            <!-- API Reference -->
            <div>
              <h3 class="text-h2 font-semibold mb-4">API Reference</h3>
              <ul class="space-y-2">
                <li><a href="#" class="text-primary hover:underline">Authentication</a></li>
                <li><a href="#" class="text-primary hover:underline">Deployments API</a></li>
                <li><a href="#" class="text-primary hover:underline">Projects API</a></li>
                <li><a href="#" class="text-primary hover:underline">Logs API</a></li>
              </ul>
            </div>
          </div>

          <p class="text-sm text-muted-foreground mt-8">
            TODO: These are placeholder links. Actual documentation content would be in individual pages or a headless CMS.
          </p>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>
