---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy | Kubeletto" description="Privacy Policy for Kubeletto - How we collect, use, and protect your data">
  <div class="legal-page">
    <!-- Decorative shapes like hero -->
    <div class="page-shapes" aria-hidden="true">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
    </div>

    <main class="legal-main">
      <div class="legal-header">
        <a href="/" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Home
        </a>
        <p class="legal-label">Legal</p>
        <h1>Privacy Policy</h1>
        <p class="legal-updated">Last updated: January 12, 2026</p>
      </div>

      <div class="legal-content">
        <div class="legal-card">
          <section>
            <h2>1. Introduction</h2>
            <p>Kubeletto ("we", "our", or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our cloud deployment platform.</p>
          </section>

          <section>
            <h2>2. Information We Collect</h2>
            <div class="info-grid">
              <div class="info-box">
                <h3>Personal Information</h3>
                <ul>
                  <li>Name and email address</li>
                  <li>Account credentials</li>
                  <li>Payment information (via our payment provider)</li>
                  <li>GitHub/GitLab account info</li>
                </ul>
              </div>
              <div class="info-box">
                <h3>Usage Information</h3>
                <ul>
                  <li>Application deployment logs</li>
                  <li>Service usage metrics</li>
                  <li>IP address and browser info</li>
                  <li>Device information</li>
                </ul>
              </div>
            </div>
          </section>

          <section>
            <h2>3. How We Use Your Information</h2>
            <p>We use the information we collect to:</p>
            <ul>
              <li>Provide and maintain our services</li>
              <li>Process your transactions and subscriptions</li>
              <li>Send you service-related communications</li>
              <li>Respond to your inquiries and support requests</li>
              <li>Improve our services and user experience</li>
              <li>Detect and prevent fraud or abuse</li>
            </ul>
          </section>

          <section>
            <h2>4. Payment Processing</h2>
            <div class="highlight-box">
              <div class="highlight-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
              </div>
              <div class="highlight-content">
                <h3>Secure Payment Processing</h3>
                <p>Your payment information is collected and processed directly by our authorized payment provider in Indonesian Rupiah (IDR), in accordance with their privacy policy and security standards. We do not store your complete credit card or bank account details on our servers.</p>
              </div>
            </div>
          </section>

          <section>
            <h2>5. Data Security</h2>
            <p>We implement appropriate technical and organizational security measures to protect your personal information, including:</p>
            <div class="security-features">
              <div class="security-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Encryption in transit & at rest</span>
              </div>
              <div class="security-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Regular security assessments</span>
              </div>
              <div class="security-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Access controls & authentication</span>
              </div>
              <div class="security-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Enterprise-grade infrastructure</span>
              </div>
            </div>
          </section>

          <section>
            <h2>6. Data Retention</h2>
            <p>We retain your personal information for as long as your account is active or as needed to provide you services. We will also retain and use your information to comply with legal obligations, resolve disputes, and enforce our agreements.</p>
          </section>

          <section>
            <h2>7. Your Rights</h2>
            <p>You have the right to:</p>
            <ul>
              <li>Access your personal data</li>
              <li>Correct inaccurate data</li>
              <li>Request deletion of your data</li>
              <li>Export your data in a portable format</li>
              <li>Opt-out of marketing communications</li>
            </ul>
          </section>

          <section>
            <h2>8. Third-Party Services</h2>
            <p>We may share your information with third-party service providers who assist us in operating our platform, including:</p>
            <ul>
              <li>Cloud infrastructure providers</li>
              <li>Third-party payment processors</li>
              <li>Analytics services</li>
              <li>Email service providers</li>
            </ul>
          </section>

          <section>
            <h2>9. Cookies</h2>
            <p>We use cookies and similar tracking technologies to enhance your experience on our platform. You can control cookie preferences through your browser settings.</p>
          </section>

          <section>
            <h2>10. Changes to This Policy</h2>
            <p>We may update this Privacy Policy from time to time. We will notify you of any changes by posting the new Privacy Policy on this page and updating the "Last updated" date.</p>
          </section>

          <section>
            <h2>11. Contact Us</h2>
            <p>If you have any questions about this Privacy Policy, please contact us:</p>
            <div class="contact-box">
              <p><strong>Email:</strong> support@kubeletto.com</p>
              <p><strong>Phone:</strong> +62 882 003 359 369</p>
              <p><strong>Address:</strong> Jakarta, Indonesia</p>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<style>
  .legal-page {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--paper) 0%, #f8f9fa 100%);
    position: relative;
    overflow: hidden;
  }

  /* Decorative shapes */
  .page-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.03;
    background: var(--ink);
  }

  .shape-1 {
    width: 500px;
    height: 500px;
    top: -100px;
    right: -100px;
  }

  .shape-2 {
    width: 300px;
    height: 300px;
    bottom: 20%;
    left: -50px;
  }

  .legal-main {
    margin-left: var(--nav-width);
    padding: 4rem 4rem 6rem;
    position: relative;
    z-index: 10;
  }

  .legal-header {
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--steel);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: all 0.3s var(--ease-out-expo);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    background: var(--glass);
    backdrop-filter: blur(10px);
    border: 1px solid var(--steel-light);
  }

  .back-link:hover {
    color: var(--ink);
    background: var(--paper);
    transform: translateX(-4px);
  }

  .back-link svg {
    width: 1rem;
    height: 1rem;
  }

  .legal-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .legal-updated {
    color: var(--steel);
    font-size: 0.9rem;
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .legal-card {
    background: var(--paper);
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 4px 40px rgba(0,0,0,0.06);
    border: 1px solid var(--steel-light);
  }

  section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--steel-light);
  }

  section:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  p {
    color: var(--ink-soft);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  ul {
    color: var(--ink-soft);
    line-height: 1.8;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  li::marker {
    color: var(--blue);
  }

  strong {
    color: var(--ink);
    font-weight: 600;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 1rem 0;
  }

  .info-box {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.25rem;
    border: 1px solid var(--steel-light);
  }

  .info-box h3 {
    margin-bottom: 0.5rem;
  }

  .info-box ul {
    margin-bottom: 0;
    padding-left: 1.25rem;
  }

  .highlight-box {
    display: flex;
    gap: 1.5rem;
    background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid var(--steel-light);
    align-items: flex-start;
  }

  .highlight-icon {
    width: 48px;
    height: 48px;
    background: var(--blue);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .highlight-icon svg {
    width: 24px;
    height: 24px;
    color: var(--paper);
  }

  .highlight-content h3 {
    margin-bottom: 0.5rem;
  }

  .highlight-content p {
    margin-bottom: 0;
  }

  .security-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .security-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 10px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .security-item svg {
    width: 20px;
    height: 20px;
    color: var(--blue);
    flex-shrink: 0;
  }

  .contact-box {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid var(--steel-light);
  }

  .contact-box p {
    margin-bottom: 0.5rem;
  }

  .contact-box p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .legal-main {
      margin-left: 0;
      padding: 2rem;
    }

    .legal-card {
      padding: 1.5rem;
    }

    .info-grid,
    .security-features {
      grid-template-columns: 1fr;
    }

    .highlight-box {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
