---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Section from '@/components/common/Section.astro';
import Card from '@/components/common/Card.astro';
import Button from '@/components/common/Button.astro';
---

<BaseLayout title="Contact - Kubeletto" description="Get in touch with the Kubeletto team">
  <Header />
  <main>
    <Section spacing="loose">
      <div class="max-w-[600px] mx-auto text-center">
        <h1 class="text-display sm:text-[48px] mb-6">Get in touch</h1>
        <p class="text-lg text-muted-foreground mb-8">
          Have questions? We're here to help.
        </p>
      </div>

      <div class="max-w-[800px] mx-auto">
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Contact Form -->
          <Card class="md:col-span-1">
            <form class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium mb-2">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="w-full h-10 px-3 rounded-sm border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder="Your name"
                  required
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full h-10 px-3 rounded-sm border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder="your.email@example.com"
                  required
                />
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium mb-2">Subject</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  class="w-full h-10 px-3 rounded-sm border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder="How can we help?"
                  required
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium mb-2">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  class="w-full px-3 py-2 rounded-sm border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"
                  placeholder="Tell us more..."
                  required
                ></textarea>
              </div>

              <Button type="submit" variant="primary" class="w-full">
                Send Message
              </Button>

              <p class="text-xs text-muted-foreground text-center">
                TODO: Implement form submission handler
              </p>
            </form>
          </Card>

          <!-- Contact Info -->
          <div class="space-y-6">
            <Card>
              <div class="flex items-start gap-4">
                <div class="p-2 rounded-lg bg-primary/10">
                  <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-h2 font-semibold mb-1">Email</h3>
                  <a href="mailto:support@kubeletto.com" class="text-sm text-primary hover:underline">
                    support@kubeletto.com
                  </a>
                  <p class="text-xs text-muted-foreground mt-1">We typically respond within 24 hours</p>
                </div>
              </div>
            </Card>

            <Card>
              <div class="flex items-start gap-4">
                <div class="p-2 rounded-lg bg-primary/10">
                  <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-h2 font-semibold mb-1">Discord Community</h3>
                  <a href="#" class="text-sm text-primary hover:underline">
                    Join our Discord
                  </a>
                  <p class="text-xs text-muted-foreground mt-1">Chat with the team and community</p>
                </div>
              </div>
            </Card>

            <Card>
              <div class="flex items-start gap-4">
                <div class="p-2 rounded-lg bg-primary/10">
                  <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-h2 font-semibold mb-1">Documentation</h3>
                  <a href="/docs" class="text-sm text-primary hover:underline">
                    Browse docs
                  </a>
                  <p class="text-xs text-muted-foreground mt-1">Find answers in our documentation</p>
                </div>
              </div>
            </Card>

            <Card>
              <div class="flex items-start gap-4">
                <div class="p-2 rounded-lg bg-primary/10">
                  <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-h2 font-semibold mb-1">GitHub</h3>
                  <a href="https://github.com/kubeletto" target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline">
                    @kubeletto
                  </a>
                  <p class="text-xs text-muted-foreground mt-1">Report issues and contribute</p>
                </div>
              </div>
            </Card>
          </div>
        </div>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>
